# All provider access should stay within free tiers; set spending limits at providers if available.
# Required free API credentials
YOUTUBE_API_KEY=
GROQ_API_KEY=

# Required only when AUTO_PUBLISH=true (default)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Publishing and resource limits
AUTO_PUBLISH=true
MAX_UPLOADS_PER_DAY=2
MAX_CANDIDATES=35
MAX_SEARCHES_PER_RUN=4
MAX_CREATOR_CHANNELS_PER_RUN=4
HISTORY_RETENTION_DAYS=21
MIN_SCRIPT_QUALITY=70
MAX_SOURCE_AGE_DAYS=14
VIDEO_LANGUAGE=en
VIDEO_CATEGORY_ID=24
VIDEO_PRIVACY_STATUS=public

# Geographic discovery and watchlist (pipe-separated)
YOUTUBE_REGIONS=US|GB|CA|AU
YOUTUBE_CREATOR_HANDLES=MrBeast|MarkRober|RyanTrahan|Sidemen|Airrack|Mrwhosetheboss|MKBHD
YOUTUBE_SEARCH_QUERIES=creator economy|YouTube challenge|AI creators|gaming creator|business creator|creator strategy|viral storytelling|technology creator
MAX_CREATOR_CHANNELS_PER_RUN=4
MAX_SEARCHES_PER_RUN=4

# Groq free-tier text generation
GROQ_MODEL=openai/gpt-oss-20b

# Fully local, free synthetic narration (requires espeak-ng)
LOCAL_TTS_VOICE=en-us+m3
