# Required for production runs
YOUTUBE_API_KEY=
OPENAI_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Publishing and quality controls
AUTO_PUBLISH=true
MAX_UPLOADS_PER_DAY=2
MAX_CANDIDATES=35
MAX_SEARCHES_PER_RUN=4
MAX_CREATOR_CHANNELS_PER_RUN=4
HISTORY_RETENTION_DAYS=21
MIN_SCRIPT_QUALITY=70
MAX_SOURCE_AGE_DAYS=14
VIDEO_LANGUAGE=en
VIDEO_CATEGORY_ID=24
VIDEO_PRIVACY_STATUS=public

# Geographic discovery. The audience is English-language Western markets.
YOUTUBE_REGIONS=US|GB|CA|AU
# Queries are rotated across runs to keep well inside default API quotas.
YOUTUBE_CREATOR_HANDLES=MrBeast|MarkRober|RyanTrahan|Sidemen|Airrack|Mrwhosetheboss|MKBHD
YOUTUBE_SEARCH_QUERIES=creator economy|YouTube challenge|AI creators|gaming creator|business creator|creator strategy|viral storytelling|technology creator

# Models and narration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Speak with clear, energetic, natural American-English delivery. Sound curious and analytical, not exaggerated or clickbait-heavy.
